# Copy this file to .env and adjust as needed

# Postgres in prod, sqlite works fine for local/dev
DATABASE_URL=sqlite:///./job_board.db
# DATABASE_URL=postgresql://user:password@localhost:5432/mmml_job_board

REDIS_URL=redis://localhost:6379/0

# Comma-separated origins allowed to call the public API from the marketing site
ALLOWED_ORIGINS=*
